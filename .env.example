# Supabase project (Project settings > API). Both values are safe to expose: the publishable key only
# does what Row Level Security allows. Leave them empty to run the site on the sample data in src/mock/api.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public address of the site, used for share previews, the sitemap and the RSS feed (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret that makes the daily visitor hash in analytics unguessable. Any long random string (openssl rand -hex 32).
ANALYTICS_SALT=

# Server-only. Required for contact submissions, telemetry, security counters/notices, Gmail and user management.
# Without it the contact endpoint returns 503 and telemetry is ignored. Never prefix it with NEXT_PUBLIC_ or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Self-hosted only: name of an IP header your ingress OVERWRITES, with direct access to Next blocked.
# Leave unset unless that trust boundary exists. Vercel uses its platform-controlled header automatically.
TRUSTED_PROXY_IP_HEADER=

