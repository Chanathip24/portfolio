# Supabase project (Project settings > API). Both values are safe to expose: the publishable key only
# does what Row Level Security allows. Leave them empty to run the site on the sample data in src/mock/api.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public address of the site, used for share previews, the sitemap and the RSS feed (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret that makes the daily visitor hash in analytics unguessable. Any long random string (openssl rand -hex 32).
ANALYTICS_SALT=

# Server-only. Needed for the Users screen (adding people, resetting passwords and authenticators, blocking, deleting).
# This key bypasses every security rule: never prefix it with NEXT_PUBLIC_, never commit it, and leave it unset if you
# do not need user management (the rest of the admin works without it).
SUPABASE_SERVICE_ROLE_KEY=

